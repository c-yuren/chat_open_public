# ============================================================
#  Open E2EE Chat「仁 (公開版)」— 環境變數設定
# ============================================================

# 監聽埠號 (若與原本的私人聊天室同台 VM，建議設 3001)
PORT=3001

# CORS 跨域允許 (前端 Vercel 網址，* 代表全允許)
ALLOWED_ORIGINS=*

# 每個聊天室最大保留訊息數 (預設 50，超過自動 FIFO 滾動清除)
MAX_MESSAGES_PER_ROOM=50

# 閒置聊天室過期天數 (預設 14 天無活動自動釋放磁碟空間)
ROOM_EXPIRE_DAYS=14

# 管理員儀表板金鑰 (預設: ren-admin-2026，請依需求更換)
ADMIN_KEY=ren-admin-2026
